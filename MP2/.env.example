# Template of environment variables for MP2 — safe to commit (no real secrets).
# Copy this to `.env.local` and `.env`, then fill in real values.
# `.env` and `.env.*` (except this file) are git-ignored.

# Postgres — use the Supabase "prisma" DB user (see Supabase SQL Editor setup in docs).
# Pooled URL for the app (port 6543 + ?pgbouncer=true). Secret.
DATABASE_URL="postgresql://prisma.[ref]:[PRISMA-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler URL for Prisma migrations (port 5432). Secret.
DIRECT_URL="postgresql://prisma.[ref]:[PRISMA-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project (auth + realtime, planned).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Google OAuth Client ID/Secret are configured inside Supabase Auth provider settings,
# not in this app env file. See GOOGLE_AUTH_SETUP.md.

# Anthropic API key — used to name affinity groups/themes. Secret.
# Leave blank/omit to use the deterministic keyword-naming fallback.
ANTHROPIC_API_KEY="your-anthropic-key"
