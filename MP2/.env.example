# Template of environment variables for MP2 — safe to commit (no real secrets).
# Copy this to `.env.local` and fill in real values. `.env` and `.env.*` (except
# this file) are git-ignored, so real keys are never pushed to GitHub.

# Postgres — pooled URL for the app (Supabase: port 6543 + ?pgbouncer=true). Secret.
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session URL for Prisma migrations (Supabase: port 5432). Secret.
DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project (auth + realtime, planned).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Google OAuth Client ID/Secret are configured inside Supabase Auth provider settings,
# not in this app env file. See GOOGLE_AUTH_SETUP.md.

# Anthropic API key — used to name affinity groups/themes. Secret.
# Leave blank/omit to use the deterministic keyword-naming fallback.
ANTHROPIC_API_KEY="your-anthropic-key"
